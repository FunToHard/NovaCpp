{
  "name": "novacpp",
  "displayName": "NovaCpp",
  "description": "High-performance C/C++ language support, debugging, and tooling for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "novacpp",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Formatters"
  ],
  "keywords": [
    "c",
    "c++",
    "cpp",
    "clangd",
    "lldb",
    "gdb"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:cuda-cpp",
    "onCommand:novacpp.openSettings",
    "onCommand:novacpp.restartServer",
    "onCommand:novacpp.switchSourceHeader",
    "onCommand:novacpp.installClangd",
    "onDebugResolve:novacpp-debug",
    "onTaskType:novacpp",
    "onTaskType:msbuild",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Running, debugging, and task execution are disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "novacpp.logDiagnostics",
        "title": "NovaCpp: Log Diagnostics",
        "category": "C/C++"
      },
      {
        "command": "novacpp.resetIndex",
        "title": "NovaCpp: Reset Clangd Symbol Index",
        "category": "C/C++"
      },
      {
        "command": "novacpp.goToNextDirectiveInGroup",
        "title": "NovaCpp: Go to Next Directive in Group",
        "category": "C/C++"
      },
      {
        "command": "novacpp.goToPrevDirectiveInGroup",
        "title": "NovaCpp: Go to Previous Directive in Group",
        "category": "C/C++"
      },
      {
        "command": "novacpp.generateDoxygenComment",
        "title": "NovaCpp: Generate Doxygen Documentation Comment",
        "category": "C/C++"
      },
      {
        "command": "novacpp.runClangTidyOnActiveFile",
        "title": "NovaCpp: Run Clang-Tidy Analysis on Active File",
        "category": "C/C++"
      },
      {
        "command": "novacpp.clearCodeAnalysisDiagnostics",
        "title": "NovaCpp: Clear Clang-Tidy Diagnostics",
        "category": "C/C++"
      },
      {
        "command": "novacpp.setVsDeveloperEnvironment",
        "title": "NovaCpp: Set Visual Studio Developer Environment",
        "category": "C/C++"
      },
      {
        "command": "novacpp.clearVsDeveloperEnvironment",
        "title": "NovaCpp: Clear Visual Studio Developer Environment",
        "category": "C/C++"
      },
      {
        "command": "novacpp.selectProfile",
        "title": "NovaCpp: Select Target Configuration Profile",
        "category": "C/C++"
      },
      {
        "command": "novacpp.pickProcess",
        "title": "NovaCpp: Pick Process to Attach",
        "category": "C/C++"
      },
      {
        "command": "novacpp.solutionMenu",
        "title": "NovaCpp: Solution Actions Menu",
        "category": "C/C++"
      },
      {
        "command": "novacpp.selectSolution",
        "title": "NovaCpp: Select Active Solution (.sln / .slnx)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.selectSolutionConfiguration",
        "title": "NovaCpp: Select Solution Configuration",
        "category": "C/C++"
      },
      {
        "command": "novacpp.buildSolution",
        "title": "NovaCpp: Build Solution (MSBuild)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.rebuildSolution",
        "title": "NovaCpp: Rebuild Solution (MSBuild)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.cleanSolution",
        "title": "NovaCpp: Clean Solution (MSBuild)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.generateCompilationDbFromSolution",
        "title": "NovaCpp: Generate compile_commands.json from Solution",
        "category": "C/C++"
      },
      {
        "command": "novacpp.openSettings",
        "title": "NovaCpp: Open Configuration Panel",
        "category": "C/C++"
      },
      {
        "command": "novacpp.inspectMemoryLayout",
        "title": "NovaCpp: Inspect Type & Memory Layout (Struct Padding / Alignment)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.analyzeIncludes",
        "title": "NovaCpp: Analyze #include Hierarchy & Dependencies",
        "category": "C/C++"
      },
      {
        "command": "novacpp.visualizeTimeTrace",
        "title": "NovaCpp: Visualize Clang -ftime-trace Build Bottlenecks",
        "category": "C/C++"
      },
      {
        "command": "novacpp.refreshTests",
        "title": "NovaCpp: Discover & Refresh Unit Tests",
        "category": "C/C++"
      },
      {
        "command": "novacpp.expandMacro",
        "title": "NovaCpp: Expand Macro at Cursor (Step-by-Step)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.evaluateConstexpr",
        "title": "NovaCpp: Evaluate constexpr Expression at Cursor",
        "category": "C/C++"
      },
      {
        "command": "novacpp.restartServer",
        "title": "NovaCpp: Restart Language Server",
        "category": "C/C++"
      },
      {
        "command": "novacpp.toggleDimInactiveRegions",
        "title": "NovaCpp: Toggle Inactive Regions Dimming",
        "category": "C/C++"
      },
      {
        "command": "novacpp.switchSourceHeader",
        "title": "NovaCpp: Switch Header/Source",
        "category": "C/C++"
      },
      {
        "command": "novacpp.installClangd",
        "title": "NovaCpp: Download and Install clangd",
        "category": "C/C++"
      },
      {
        "command": "novacpp.detectCompilers",
        "title": "NovaCpp: Scan for Installed Compilers",
        "category": "C/C++"
      },
      {
        "command": "novacpp.generateCompileFlags",
        "title": "NovaCpp: Generate compile_flags.txt",
        "category": "C/C++"
      },
      {
        "command": "novacpp.runFile",
        "title": "Run C/C++ File",
        "icon": "$(play)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.debugFile",
        "title": "Debug C/C++ File",
        "icon": "$(debug-alt)",
        "category": "C/C++"
      },
      {
        "command": "novacpp.openDocs",
        "title": "NovaCpp: Open C++ Reference Documentation",
        "category": "C/C++"
      },
      {
        "command": "novacpp.inspectTelemetry",
        "title": "NovaCpp: Inspect Anonymous STL Telemetry Buffer",
        "category": "C/C++"
      },
      {
        "command": "novacpp.flushTelemetry",
        "title": "NovaCpp: Flush Telemetry Batch",
        "category": "C/C++"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "novacpp.runFile",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@1"
        },
        {
          "command": "novacpp.debugFile",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "novacpp.switchSourceHeader",
        "key": "alt+o",
        "mac": "alt+cmd+o",
        "when": "editorTextFocus && (editorLangId == c || editorLangId == cpp)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "NovaCpp",
      "properties": {
        "novacpp.clangdPath": {
          "type": "string",
          "default": "",
          "description": "Path to the clangd executable. If empty, NovaCpp searches PATH and the auto-installed binary."
        },
        "novacpp.clangdArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional command-line arguments to pass to clangd."
        },
        "novacpp.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "Path to lldb-dap or gdb. If empty, NovaCpp will detect it automatically."
        },
        "novacpp.cppStandard": {
          "type": "string",
          "enum": [
            "c++98",
            "c++03",
            "c++11",
            "c++14",
            "c++17",
            "c++20",
            "c++23",
            "c++26"
          ],
          "default": "c++20",
          "description": "Default C++ language standard for flag synthesis."
        },
        "novacpp.cStandard": {
          "type": "string",
          "enum": [
            "c89",
            "c99",
            "c11",
            "c17",
            "c23"
          ],
          "default": "c17",
          "description": "Default C language standard for flag synthesis."
        },
        "novacpp.inactiveRegionsDimming": {
          "type": "boolean",
          "default": true,
          "description": "Dim inactive #ifdef preprocessor branches using native Clang AST."
        },
        "novacpp.inactiveRegionForegroundColor": {
          "type": "string",
          "default": "disabledForeground",
          "description": "Font color applied to inactive preprocessor regions. Accepts a ThemeColor id (e.g. 'disabledForeground', 'descriptionForeground'), a hexadecimal color (e.g. '#808080'), or 'none' to preserve original syntax colors."
        },
        "novacpp.inactiveRegionOpacity": {
          "type": "number",
          "default": 0.6,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Opacity level applied to inactive preprocessor code regions (0.1 to 1.0)."
        },
        "novacpp.inactiveRegionBackgroundColor": {
          "type": "string",
          "default": "",
          "description": "Optional background color applied to inactive preprocessor regions (hex color or ThemeColor id)."
        },
        "novacpp.postfixCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable C++ Postfix Completion templates (.if, .for, .var, .unique, etc.)."
        },
        "novacpp.doxygen.generateOnType": {
          "type": "boolean",
          "default": true,
          "description": "Automatically provide Doxygen completion snippet when typing /** above a C++ declaration."
        },
        "novacpp.doxygen.generateOnCodeAction": {
          "type": "boolean",
          "default": true,
          "description": "Provide a lightbulb Code Action to generate Doxygen documentation comments for C++ declarations."
        },
        "novacpp.doxygen.generatedStyle": {
          "type": "string",
          "enum": [
            "/**",
            "/*!",
            "///",
            "//!"
          ],
          "default": "/**",
          "description": "Comment style syntax used when generating Doxygen comment blocks."
        },
        "novacpp.codeAnalysis.clangTidy.path": {
          "type": "string",
          "default": "",
          "description": "Explicit filesystem path to clang-tidy binary. If empty, NovaCpp searches PATH and standard LLVM directories."
        },
        "novacpp.codeAnalysis.clangTidy.checks.enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of Clang-Tidy checks or families to enable (e.g. ['modernize-*', 'readability-*'])."
        },
        "novacpp.codeAnalysis.clangTidy.checks.disabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of Clang-Tidy checks or families to suppress (e.g. ['modernize-use-trailing-return-type'])."
        },
        "novacpp.persistVsDeveloperEnvironment": {
          "type": "boolean",
          "default": true,
          "description": "Preserve the selected Visual Studio Developer Environment across editor restarts on Windows."
        },
        "novacpp.vcpkg.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable intelligent header recommendations and Code Actions for vcpkg packages."
        },
        "novacpp.addNodeAddonIncludePaths": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect and inject include paths for nan and node-addon-api if detected in package.json."
        },
        "novacpp.discovery.detectExternalSdks": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect common external SDKs (Vulkan SDK, raylib, CUDA Toolkit, Boost, SDL) for fallback IntelliSense flags and flag synthesis."
        },
        "novacpp.default.forcedInclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of header files to force-include before compilation (/FI on MSVC, -include on GCC/Clang)."
        },
        "novacpp.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Display parameter name inlay hints in function and method calls."
        },
        "novacpp.inlayHints.deducedTypes": {
          "type": "boolean",
          "default": true,
          "description": "Display deduced type inlay hints for auto variables."
        },
        "novacpp.inlayHints.designators": {
          "type": "boolean",
          "default": true,
          "description": "Display struct field designators in brace initialization."
        },
        "novacpp.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable anonymous C++ Standard Library (STL) symbol frequency collection to boost autocomplete suggestion accuracy. Zero user code or PII is ever collected."
        },
        "novacpp.telemetry.endpoint": {
          "type": "string",
          "default": "https://telemetry.novacpp.dev/v1/telemetry/stl-usage",
          "description": "Ingestion endpoint URL for anonymous STL usage telemetry batches."
        }
      }
    },
    "debuggers": [
      {
        "type": "novacpp-debug",
        "label": "NovaCpp: C/C++ Debugger (lldb-dap / GDB)",
        "languages": [
          "c",
          "cpp",
          "cuda-cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the executable binary to debug.",
                "default": "${workspaceFolder}/build/${fileBasenameNoExtension}"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the program.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Current working directory for the target process.",
                "default": "${workspaceFolder}"
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Automatically stop at program entry point (main).",
                "default": false
              },
              "environment": {
                "type": "array",
                "description": "Environment variables to pass to the target program.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                },
                "default": []
              },
              "debuggerPath": {
                "type": "string",
                "description": "Explicit path to lldb-dap or gdb executable."
              },
              "debuggerType": {
                "type": "string",
                "enum": [
                  "auto",
                  "lldb-dap",
                  "gdb"
                ],
                "default": "auto",
                "description": "Debugger backend to use."
              }
            }
          }
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "novacpp",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "NovaCpp task action name (e.g. buildActiveFile, buildWorkspace)"
          },
          "file": {
            "type": "string",
            "description": "Source file to compile"
          }
        }
      },
      {
        "type": "msbuild",
        "required": [
          "solution"
        ],
        "properties": {
          "solution": {
            "type": "string",
            "description": "Path to the .sln or .slnx solution file"
          },
          "project": {
            "type": "string",
            "description": "Optional project path to build"
          },
          "configuration": {
            "type": "string",
            "description": "Build configuration (e.g. Debug, Release)"
          },
          "platform": {
            "type": "string",
            "description": "Target platform (e.g. x64, x86, ARM64)"
          },
          "target": {
            "type": "string",
            "description": "MSBuild target (Build, Rebuild, Clean)"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "gcc",
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "msvc",
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)(?:,(\\d+))?\\):\\s+(warning|error)\\s+([A-Z0-9]+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "novacpp_configuration",
        "toolReferenceName": "cpp",
        "displayName": "C/C++ Project Configuration",
        "canBeReferencedInPrompt": true,
        "modelDescription": "For the active C or C++ file, this tool provides: the language (C, C++, or CUDA), the language standard version, the compiler (GCC, Clang, or MSVC), the target platform, active preprocessor defines, and solution/build configuration."
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/novacpp/novacpp"
  },
  "license": "MIT",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "test": "npm run check-types && mocha",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "dependencies": {
    "@clangd/install": "^0.1.20",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/which": "^3.0.4",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "mocha": "^10.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
