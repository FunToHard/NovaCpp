{
  "name": "turbocpp",
  "displayName": "TurboCpp",
  "description": "High-performance C/C++ language support, debugging, and tooling for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "FunToHard",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Formatters"
  ],
  "keywords": [
    "c",
    "c++",
    "cpp",
    "clangd",
    "lldb",
    "gdb"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:cuda-cpp",
    "onCommand:turbocpp.openSettings",
    "onCommand:turbocpp.restartServer",
    "onCommand:turbocpp.switchSourceHeader",
    "onCommand:turbocpp.installClangd",
    "onDebugResolve:turbocpp-debug",
    "onTaskType:turbocpp",
    "onTaskType:msbuild",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/CMakeLists.txt"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Running, debugging, and task execution are disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "turbocpp.logDiagnostics",
        "title": "TurboCpp: Log Diagnostics",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.resetIndex",
        "title": "TurboCpp: Reset Clangd Symbol Index",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.goToNextDirectiveInGroup",
        "title": "TurboCpp: Go to Next Directive in Group",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.goToPrevDirectiveInGroup",
        "title": "TurboCpp: Go to Previous Directive in Group",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.generateDoxygenComment",
        "title": "TurboCpp: Generate Doxygen Documentation Comment",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.runClangTidyOnActiveFile",
        "title": "TurboCpp: Run Clang-Tidy Analysis on Active File",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.clearCodeAnalysisDiagnostics",
        "title": "TurboCpp: Clear Clang-Tidy Diagnostics",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.setVsDeveloperEnvironment",
        "title": "TurboCpp: Set Visual Studio Developer Environment",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.clearVsDeveloperEnvironment",
        "title": "TurboCpp: Clear Visual Studio Developer Environment",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.selectProfile",
        "title": "TurboCpp: Select Target Configuration Profile",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.pickProcess",
        "title": "TurboCpp: Pick Process to Attach",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.solutionMenu",
        "title": "TurboCpp: Solution Actions Menu",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.selectSolution",
        "title": "TurboCpp: Select Active Solution (.sln / .slnx)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.selectSolutionConfiguration",
        "title": "TurboCpp: Select Solution Configuration",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.buildSolution",
        "title": "TurboCpp: Build Solution (MSBuild)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.rebuildSolution",
        "title": "TurboCpp: Rebuild Solution (MSBuild)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.cleanSolution",
        "title": "TurboCpp: Clean Solution (MSBuild)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.generateCompilationDbFromSolution",
        "title": "TurboCpp: Generate compile_commands.json from Solution",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.cmake.menu",
        "title": "TurboCpp: CMake Intelligence Menu",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.cmake.rescan",
        "title": "TurboCpp: Re-scan CMakeLists.txt Includes",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.cmake.generateCompilationDatabase",
        "title": "TurboCpp: Generate compile_commands.json from CMakeLists.txt",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.openSettings",
        "title": "TurboCpp: Open Configuration Panel",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.inspectMemoryLayout",
        "title": "TurboCpp: Inspect Type & Memory Layout (Struct Padding / Alignment)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.analyzeIncludes",
        "title": "TurboCpp: Analyze #include Hierarchy & Dependencies",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.visualizeTimeTrace",
        "title": "TurboCpp: Visualize Clang -ftime-trace Build Bottlenecks",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.refreshTests",
        "title": "TurboCpp: Discover & Refresh Unit Tests",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.expandMacro",
        "title": "TurboCpp: Expand Macro at Cursor (Step-by-Step)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.evaluateConstexpr",
        "title": "TurboCpp: Evaluate constexpr Expression at Cursor",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.viewDisassembly",
        "title": "TurboCpp: Open Inline Compiler Disassembly (Assembly View)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.setDisassemblyOptimizationLevel",
        "title": "TurboCpp: Set Disassembly Optimization Level",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.showTypeHierarchy",
        "title": "TurboCpp: Show Visual Type & Inheritance Hierarchy Graph",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.restartServer",
        "title": "TurboCpp: Restart Language Server",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.toggleDimInactiveRegions",
        "title": "TurboCpp: Toggle Inactive Regions Dimming",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.switchSourceHeader",
        "title": "TurboCpp: Switch Header/Source",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.installClangd",
        "title": "TurboCpp: Download and Install clangd",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.detectCompilers",
        "title": "TurboCpp: Scan for Installed Compilers",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.generateCompileFlags",
        "title": "TurboCpp: Generate compile_flags.txt",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.runFile",
        "title": "Run C/C++ File",
        "icon": "$(play)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.debugFile",
        "title": "Debug C/C++ File",
        "icon": "$(debug-alt)",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.openDocs",
        "title": "TurboCpp: Open C++ Reference Documentation",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.inspectTelemetry",
        "title": "TurboCpp: Inspect Anonymous STL Telemetry Buffer",
        "category": "C/C++"
      },
      {
        "command": "turbocpp.flushTelemetry",
        "title": "TurboCpp: Flush Telemetry Batch",
        "category": "C/C++"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "turbocpp.runFile",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@1"
        },
        {
          "command": "turbocpp.debugFile",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "turbocpp.switchSourceHeader",
        "key": "alt+o",
        "mac": "alt+cmd+o",
        "when": "editorTextFocus && (editorLangId == c || editorLangId == cpp)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TurboCpp",
      "properties": {
        "turbocpp.clangdPath": {
          "type": "string",
          "default": "",
          "description": "Path to the clangd executable. If empty, TurboCpp searches PATH and the auto-installed binary."
        },
        "turbocpp.clangdArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional command-line arguments to pass to clangd."
        },
        "turbocpp.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "Path to lldb-dap or gdb. If empty, TurboCpp will detect it automatically."
        },
        "turbocpp.cppStandard": {
          "type": "string",
          "enum": [
            "c++98",
            "c++03",
            "c++11",
            "c++14",
            "c++17",
            "c++20",
            "c++23",
            "c++26"
          ],
          "default": "c++20",
          "description": "Default C++ language standard for flag synthesis."
        },
        "turbocpp.cStandard": {
          "type": "string",
          "enum": [
            "c89",
            "c99",
            "c11",
            "c17",
            "c23"
          ],
          "default": "c17",
          "description": "Default C language standard for flag synthesis."
        },
        "turbocpp.inactiveRegionsDimming": {
          "type": "boolean",
          "default": true,
          "description": "Dim inactive #ifdef preprocessor branches using native Clang AST."
        },
        "turbocpp.inactiveRegionForegroundColor": {
          "type": "string",
          "default": "disabledForeground",
          "description": "Font color applied to inactive preprocessor regions. Accepts a ThemeColor id (e.g. 'disabledForeground', 'descriptionForeground'), a hexadecimal color (e.g. '#808080'), or 'none' to preserve original syntax colors."
        },
        "turbocpp.inactiveRegionOpacity": {
          "type": "number",
          "default": 0.6,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Opacity level applied to inactive preprocessor code regions (0.1 to 1.0)."
        },
        "turbocpp.inactiveRegionBackgroundColor": {
          "type": "string",
          "default": "",
          "description": "Optional background color applied to inactive preprocessor regions (hex color or ThemeColor id)."
        },
        "turbocpp.postfixCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable C++ Postfix Completion templates (.if, .for, .var, .unique, etc.)."
        },
        "turbocpp.doxygen.generateOnType": {
          "type": "boolean",
          "default": true,
          "description": "Automatically provide Doxygen completion snippet when typing /** above a C++ declaration."
        },
        "turbocpp.doxygen.generateOnCodeAction": {
          "type": "boolean",
          "default": true,
          "description": "Provide a lightbulb Code Action to generate Doxygen documentation comments for C++ declarations."
        },
        "turbocpp.doxygen.generatedStyle": {
          "type": "string",
          "enum": [
            "/**",
            "/*!",
            "///",
            "//!"
          ],
          "default": "/**",
          "description": "Comment style syntax used when generating Doxygen comment blocks."
        },
        "turbocpp.codeAnalysis.clangTidy.path": {
          "type": "string",
          "default": "",
          "description": "Explicit filesystem path to clang-tidy binary. If empty, TurboCpp searches PATH and standard LLVM directories."
        },
        "turbocpp.codeAnalysis.clangTidy.checks.enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of Clang-Tidy checks or families to enable (e.g. ['modernize-*', 'readability-*'])."
        },
        "turbocpp.codeAnalysis.clangTidy.checks.disabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of Clang-Tidy checks or families to suppress (e.g. ['modernize-use-trailing-return-type'])."
        },
        "turbocpp.persistVsDeveloperEnvironment": {
          "type": "boolean",
          "default": true,
          "description": "Preserve the selected Visual Studio Developer Environment across editor restarts on Windows."
        },
        "turbocpp.vcpkg.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable intelligent header recommendations and Code Actions for vcpkg packages."
        },
        "turbocpp.addNodeAddonIncludePaths": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect and inject include paths for nan and node-addon-api if detected in package.json."
        },
        "turbocpp.discovery.detectExternalSdks": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect common external SDKs (Vulkan SDK, raylib, CUDA Toolkit, Boost, SDL) for fallback IntelliSense flags and flag synthesis."
        },
        "turbocpp.default.forcedInclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of header files to force-include before compilation (/FI on MSVC, -include on GCC/Clang)."
        },
        "turbocpp.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Display parameter name inlay hints in function and method calls."
        },
        "turbocpp.inlayHints.deducedTypes": {
          "type": "boolean",
          "default": true,
          "description": "Display deduced type inlay hints for auto variables."
        },
        "turbocpp.inlayHints.designators": {
          "type": "boolean",
          "default": true,
          "description": "Display struct field designators in brace initialization."
        },
        "turbocpp.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable anonymous C++ Standard Library (STL) symbol frequency collection to boost autocomplete suggestion accuracy. Zero user code or PII is ever collected."
        },
        "turbocpp.telemetry.endpoint": {
          "type": "string",
          "default": "https://telemetry.turbocpp.dev/v1/telemetry/stl-usage",
          "description": "Ingestion endpoint URL for anonymous STL usage telemetry batches. Must use the secure HTTPS protocol."
        },
        "turbocpp.cmake.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically parse CMakeLists.txt and include discovered directories into IntelliSense."
        }
      }
    },
    "debuggers": [
      {
        "type": "turbocpp-debug",
        "label": "TurboCpp: C/C++ Debugger (lldb-dap / GDB)",
        "languages": [
          "c",
          "cpp",
          "cuda-cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the executable binary to debug.",
                "default": "${workspaceFolder}/build/${fileBasenameNoExtension}"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the program.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Current working directory for the target process.",
                "default": "${workspaceFolder}"
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Automatically stop at program entry point (main).",
                "default": false
              },
              "environment": {
                "type": "array",
                "description": "Environment variables to pass to the target program.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                },
                "default": []
              },
              "debuggerPath": {
                "type": "string",
                "description": "Explicit path to lldb-dap or gdb executable."
              },
              "debuggerType": {
                "type": "string",
                "enum": [
                  "auto",
                  "lldb-dap",
                  "gdb"
                ],
                "default": "auto",
                "description": "Debugger backend to use."
              }
            }
          }
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "turbocpp",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "TurboCpp task action name (e.g. buildActiveFile, buildWorkspace)"
          },
          "file": {
            "type": "string",
            "description": "Source file to compile"
          }
        }
      },
      {
        "type": "msbuild",
        "required": [
          "solution"
        ],
        "properties": {
          "solution": {
            "type": "string",
            "description": "Path to the .sln or .slnx solution file"
          },
          "project": {
            "type": "string",
            "description": "Optional project path to build"
          },
          "configuration": {
            "type": "string",
            "description": "Build configuration (e.g. Debug, Release)"
          },
          "platform": {
            "type": "string",
            "description": "Target platform (e.g. x64, x86, ARM64)"
          },
          "target": {
            "type": "string",
            "description": "MSBuild target (Build, Rebuild, Clean)"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "gcc",
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "msvc",
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)(?:,(\\d+))?\\):\\s+(warning|error)\\s+([A-Z0-9]+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "turbocpp_configuration",
        "toolReferenceName": "cpp",
        "displayName": "C/C++ Project Configuration",
        "canBeReferencedInPrompt": true,
        "modelDescription": "For the active C or C++ file, this tool provides: the language (C, C++, or CUDA), the language standard version, the compiler (GCC, Clang, or MSVC), the target platform, active preprocessor defines, and solution/build configuration."
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FunToHard/TurboCpp"
  },
  "license": "MIT",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'out'].forEach(d => fs.rmSync(d, { recursive: true, force: true })); fs.readdirSync('.').filter(f => f.endsWith('.vsix') || f.endsWith('.obj') || f.endsWith('.pdb') || f.endsWith('.ilk')).forEach(f => fs.rmSync(f, { force: true }));\"",
    "benchmark": "tsx test/benchmark.ts",
    "check-types": "tsc --noEmit",
    "test": "npm run check-types && mocha",
    "package": "npm run clean && vsce package --no-dependencies",
    "package:pre": "npm run clean && vsce package --pre-release --no-dependencies"
  },
  "dependencies": {
    "@clangd/install": "^0.1.20",
    "punycode": "^2.3.1",
    "vscode-languageclient": "^10.1.2",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.138.0",
    "@types/which": "^3.0.4",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
